{
  "manifest_version": 3,
  "name": "Personal Data Privacy Manager",
  "version": "1.0.0",
  "description": "Protect your privacy: block trackers, manage cookies, analyze privacy policies, and handle GDPR rights — all locally in your browser.",
  "author": "Privacy Manager Team",

  "permissions": [
    "tabs",
    "cookies",
    "storage",
    "declarativeNetRequest",
    "scripting",
    "webNavigation",
    "notifications",
    "activeTab"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "extension/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "extension/scripts/fingerprint-guard.js",
        "extension/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "action": {
    "default_popup": "extension/popup/popup.html",
    "default_title": "Privacy Manager"
  },

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "tracker_rules",
        "enabled": true,
        "path": "extension/rules/dnr_rules.json"
      }
    ]
  },

  "web_accessible_resources": [
    {
      "resources": [
        "extension/dashboard/dashboard.html",
        "extension/dashboard/dashboard-react.html",
        "extension/assets/*",
        "extension/storage/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}